
<?php

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Models\StudentProject;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;

class StudentProjectController extends Controller
{
    public function index(Request $request): JsonResponse
    {
        $projects = StudentProject::query()
            ->where('user_id', $request->user()->id)
            ->latest()
            ->get();

        return response()->json([
            'success' => true,
            'message' => 'Projects retrieved successfully.',
            'data' => [
                'projects' => $projects,
            ],
        ]);
    }

    public function store(Request $request): JsonResponse
    {
        $validated = $this->validateProject($request);

        $project = new StudentProject($validated);
        $project->user()->associate($request->user());
        $project->save();

        return response()->json([
            'success' => true,
            'message' => 'Project created successfully.',
            'data' => [
                'project' => $project->fresh(),
            ],
        ], 201);
    }

    public function show(
        Request $request,
        int $id
    ): JsonResponse {
        $project = $this->findProject($request, $id);

        return response()->json([
            'success' => true,
            'message' => 'Project retrieved successfully.',
            'data' => [
                'project' => $project,
            ],
        ]);
    }

    public function update(
        Request $request,
        int $id
    ): JsonResponse {
        $project = $this->findProject($request, $id);

        $validated = $this->validateProject(
            $request,
            $project
        );

        $project->update($validated);

        return response()->json([
            'success' => true,
            'message' => 'Project updated successfully.',
            'data' => [
                'project' => $project->fresh(),
            ],
        ]);
    }

    public function destroy(
        Request $request,
        int $id
    ): JsonResponse {
        $project = $this->findProject($request, $id);

        $project->delete();

        return response()->json([
            'success' => true,
            'message' => 'Project deleted successfully.',
        ]);
    }

    private function findProject(
        Request $request,
        int $id
    ): StudentProject {
        return StudentProject::query()
            ->where('user_id', $request->user()->id)
            ->findOrFail($id);
    }

    private function validateProject(
        Request $request,
        ?StudentProject $project = null
    ): array {
        $creating = $project === null;

        $validator = Validator::make($request->all(), [
            'title' => $creating
                ? ['required', 'string', 'max:255']
                : ['sometimes', 'required', 'string', 'max:255'],

            'project_type' => [
                'sometimes', 'nullable', 'string', 'max:100',
            ],

            'role' => [
                'sometimes', 'nullable', 'string', 'max:150',
            ],

            'description' => [
                'sometimes', 'nullable', 'string', 'max:10000',
            ],

            'research_field' => [
                'sometimes', 'nullable', 'string', 'max:255',
            ],

            'technologies' => [
                'sometimes', 'nullable', 'array', 'max:30',
            ],

            'technologies.*' => [
                'required', 'string', 'max:100',
            ],

            'project_url' => [
                'sometimes', 'nullable', 'url:http,https', 'max:500',
            ],

            'repository_url' => [
                'sometimes', 'nullable', 'url:http,https', 'max:500',
            ],

            'start_date' => [
                'sometimes', 'nullable', 'date_format:Y-m-d',
            ],

            'end_date' => [
                'sometimes', 'nullable', 'date_format:Y-m-d',
            ],

            'is_ongoing' => [
                'sometimes', 'boolean',
            ],

            'user_id' => [
                'prohibited',
            ],
        ]);

        $validator->after(function ($validator) use (
            $request,
            $project
        ) {
            if ($validator->errors()->isNotEmpty()) {
                return;
            }

            $isOngoing = $request->exists('is_ongoing')
                ? $request->boolean('is_ongoing')
                : (bool) ($project?->is_ongoing ?? false);

            if ($isOngoing) {
                return;
            }

            $startDate = $request->exists('start_date')
                ? $request->input('start_date')
                : $project?->start_date?->format('Y-m-d');

            $endDate = $request->exists('end_date')
                ? $request->input('end_date')
                : $project?->end_date?->format('Y-m-d');

            if (
                $startDate !== null &&
                $endDate !== null &&
                $endDate < $startDate
            ) {
                $validator->errors()->add(
                    'end_date',
                    'End date cannot be before start date.'
                );
            }
        });

        $validated = $validator->validate();

        $isOngoing = $validated['is_ongoing']
            ?? $project?->is_ongoing
            ?? false;

        if ($isOngoing) {
            $validated['end_date'] = null;
        }

        return $validated;
    }
}
